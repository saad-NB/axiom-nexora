{
  "name": "axiom-nexora-site",
  "version": "1.0.0",
  "private": true,
  "description": "Axiom Nexora. Research-grade analysis and production software.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:config": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-config.mjs",
